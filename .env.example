# ==============================================================================
# OpenMarketScanner — Configuration
# High-Throughput 5,000+ US Equities Market Scanner
# ==============================================================================

# Data Provider API Keys (Optional - Simulator is enabled by default)
POLYGON_API_KEY=your_polygon_api_key_here
FMP_API_KEY=your_financial_modeling_prep_key_here

# Scanner Execution Engine
DEFAULT_DATA_PROVIDER=simulator    # options: simulator, polygon, fmp, yahoo
CONCURRENT_WORKERS=50
SCAN_INTERVAL_SECONDS=15
UNIVERSE_SIZE=5000                 # Number of stocks in screened universe

# Quantitative Screening Thresholds
MIN_STOCK_PRICE=2.00
MAX_STOCK_PRICE=500.00
MIN_AVG_VOLUME_30D=500000
MIN_RVOL_THRESHOLD=2.0             # Relative volume multiplier (2.0x = 200% normal)
MIN_GAP_PERCENT=3.0                # Minimum % gap to trigger gap alert
MIN_BREAKOUT_CONSOLIDATION_BARS=20

# Real-Time Alerts Dispatcher
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ENABLE_DISCORD_ALERTS=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# API & WebSocket Server
API_HOST=127.0.0.1
API_PORT=8000
